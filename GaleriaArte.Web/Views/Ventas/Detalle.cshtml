@model GaleriaArte.Web.Models.Factura

@{
    ViewData["Title"] = $"Factura #{Model.IdFactura}";
}

<div class="page-header page-header-actions no-print">

    <div>
        <h1>Detalle de factura</h1>
        <p>Información completa de la venta registrada.</p>
    </div>

    <div class="table-actions">

        <a asp-controller="Ventas"
           asp-action="Historial"
           class="btn-secondary">
            Volver al historial
        </a>

        @if (Model.IdEstadoFactura == 1)
        {
            <form asp-controller="Ventas"
                  asp-action="Anular"
                  asp-route-id="@Model.IdFactura"
                  method="post"
                  onsubmit="return confirm('¿Está seguro de que desea anular esta factura? Los productos volverán al inventario.');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-state">
                    <i class="bi bi-x-circle"></i>
                    Anular factura
                </button>

            </form>
        }

        <button type="button"
                class="btn-primary"
                onclick="window.print()">
            <i class="bi bi-printer"></i>
            Imprimir
        </button>

    </div>

</div>

@if (TempData["Mensaje"] != null)
{
    <div class="message no-print">

        <strong>
            <i class="bi bi-check-circle"></i>
            @TempData["Mensaje"]
        </strong>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="message message-error no-print">
        @TempData["Error"]
    </div>
}

<div class="invoice-card"
     id="facturaImprimible">

    <div class="invoice-header">

        <div class="invoice-brand">

            <img src="~/images/logo2.png"
                 alt="Galería de Arte"
                 class="invoice-logo" />

            <div>

                <h2>Galería de Arte</h2>

                <p>
                    Comprobante de venta de productos
                </p>

            </div>

        </div>

        <div class="invoice-number">

            <span>FACTURA</span>

            <strong>
                #@Model.IdFactura
            </strong>

        </div>

    </div>

    <div class="invoice-divider"></div>

    <div class="invoice-information">

        <div class="invoice-section">

            <h3>Información del visitante</h3>

            <div class="invoice-data-row">

                <span>Cliente:</span>

                <strong>
                    @Model.NombreCliente
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Visita:</span>

                <strong>
                    #@Model.IdVisita
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Entrada:</span>

                <strong>
                    @Model.FechaIngresoVisita.ToString("dd/MM/yyyy hh:mm tt")
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Salida:</span>

                <strong>
                    @(Model.FechaSalidaVisita.HasValue
                        ? Model.FechaSalidaVisita.Value.ToString("dd/MM/yyyy hh:mm tt")
                        : "En la galería")
                </strong>

            </div>

        </div>

        <div class="invoice-section">

            <h3>Información de la venta</h3>

            <div class="invoice-data-row">

                <span>Fecha:</span>

                <strong>
                    @Model.FechaFactura.ToString("dd/MM/yyyy HH:mm")
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Método de pago:</span>

                <strong>
                    @Model.MetodoPago
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Vendedor:</span>

                <strong>
                    @Model.NombreUsuario
                </strong>

            </div>

            <div class="invoice-data-row">

                <span>Estado:</span>

                @if (Model.IdEstadoFactura == 1)
                {
                    <span class="badge status-active">
                        @Model.EstadoFactura
                    </span>
                }
                else
                {
                    <span class="badge status-inactive">
                        @Model.EstadoFactura
                    </span>
                }

            </div>

        </div>

    </div>

    <div class="invoice-detail">

        <h3>Productos adquiridos</h3>

        @if (Model.Detalles == null ||
             Model.Detalles.Count == 0)
        {
            <div class="empty">
                La factura no contiene productos registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="data-table invoice-table">

                    <thead>

                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var detalle in Model.Detalles)
                        {
                            <tr>

                                <td>
                                    @detalle.CodigoProducto
                                </td>

                                <td>

                                    <div class="obra-name">
                                        @detalle.NombreProducto
                                    </div>

                                </td>

                                <td>
                                    @detalle.Cantidad
                                </td>

                                <td>
                                    ₡@detalle.PrecioUnitario.ToString("N2")
                                </td>

                                <td>

                                    <strong>
                                        ₡@detalle.Subtotal.ToString("N2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <div class="invoice-summary">

        <div class="invoice-summary-content">

            <div class="invoice-total-row">

                <span>Subtotal</span>

                <strong>
                    ₡@Model.Subtotal.ToString("N2")
                </strong>

            </div>

            <div class="invoice-total-row">

                <span>IVA (13%)</span>

                <strong>
                    ₡@Model.Impuesto.ToString("N2")
                </strong>

            </div>

            <div class="invoice-total-row invoice-grand-total">

                <span>Total</span>

                <strong>
                    ₡@Model.Total.ToString("N2")
                </strong>

            </div>

        </div>

    </div>

    <div class="invoice-footer">

        <p>
            Gracias por su compra.
        </p>

        <small>
            Documento generado por el Sistema de Gestión de la Galería de Arte.
        </small>

    </div>

</div>

<div class="table-actions no-print">

    <a asp-controller="Ventas"
       asp-action="Index"
       class="btn-primary">
        Registrar otra venta
    </a>

    <a asp-controller="Ventas"
       asp-action="Historial"
       class="btn-secondary">
        Ver historial
    </a>

</div>

