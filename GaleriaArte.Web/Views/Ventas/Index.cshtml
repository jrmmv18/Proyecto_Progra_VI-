@model GaleriaArte.Web.Models.VentaCrearViewModel

@{
    ViewData["Title"] = "Registrar venta";
}

<div class="page-header page-header-actions">

    <div>
        <h1>Registrar venta</h1>
        <p>Compra realizada por un visitante durante su visita.</p>
    </div>

    <a asp-controller="Ventas"
       asp-action="Historial"
       class="btn-secondary">
        Ver historial
    </a>

</div>

@if (TempData["Mensaje"] != null)
{
    <div class="message">
        @TempData["Mensaje"]
    </div>
}

<form asp-controller="Ventas"
      asp-action="Index"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>

    <div class="form-card">

        <div class="form-grid">

            <div class="form-group">

                <label asp-for="IdCliente"></label>

                <select asp-for="IdCliente"
                        class="form-control">

                    <option value="">
                        Seleccione un visitante
                    </option>

                    @foreach (var cliente in Model.ClientesDisponibles)
                    {
                        <option value="@cliente.IdCliente">
                            @cliente.NombreCompleto
                        </option>
                    }

                </select>

                <span asp-validation-for="IdCliente"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="MetodoPago"></label>

                <select asp-for="MetodoPago"
                        class="form-control">

                    <option value="">
                        Seleccione
                    </option>

                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="Transferencia">Transferencia</option>

                </select>

                <span asp-validation-for="MetodoPago"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group full-width">

                @if (Model.ClientesDisponibles.Count == 0)
                {
                    <div class="secondary-text">
                        No hay visitantes dentro de la galería. Registre la
                        entrada en el módulo de Visitas antes de facturar.
                    </div>
                }
                else
                {
                    <div class="secondary-text">
                        Solo aparecen los visitantes que están dentro de la
                        galería. La compra queda ligada a su visita.
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="page-header">

        <h1>Productos</h1>

        <p>
            Marque los productos e indique la cantidad.
            El inventario se rebaja al registrar la venta.
        </p>

    </div>

    @if (Model.ProductosDisponibles.Count > 0)
    {
        <div class="filter-bar">

            <input type="search"
                   id="buscarProducto"
                   class="form-control filter-input"
                   placeholder="Nombre, código o proveedor"
                   aria-label="Buscar producto"
                   autocomplete="off" />

        </div>
    }

    @if (Model.ProductosDisponibles.Count == 0)
    {
        <div class="table-card">

            <div class="empty">
                No hay productos con existencias para vender.
            </div>

        </div>
    }
    else
    {
        <div class="table-card">

            <div class="table-responsive">

                <table class="data-table ventas-table">

                    <thead>

                        <tr>

                            <th>Incluir</th>
                            <th>Producto</th>
                            <th>Proveedor</th>
                            <th>Existencias</th>
                            <th>Precio</th>
                            <th>Cantidad</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var producto in Model.ProductosDisponibles)
                        {
                            <tr class="producto-row"
                                data-busqueda="@($"{producto.Nombre} {producto.Codigo} {producto.NombreProveedor}")">

                                <td>

                                    <input type="checkbox"
                                           class="producto-check"
                                           data-id="@producto.IdProducto"
                                           data-nombre="@producto.Nombre"
                                           data-stock="@producto.Stock"
                                           data-precio="@producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                                </td>

                                <td>

                                    <div class="obra-name">
                                        @producto.Nombre
                                    </div>

                                    <div class="obra-code">
                                        @producto.Codigo
                                    </div>

                                </td>

                                <td>

                                    <div class="artist-name">
                                        @producto.NombreProveedor
                                    </div>

                                </td>

                                <td>

                                    @if (producto.Stock <= producto.StockMinimo)
                                    {
                                        <span class="badge status-inactive">
                                            @producto.Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-active">
                                            @producto.Stock
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="value">
                                        ₡@producto.Precio.ToString("N2")
                                    </div>

                                </td>

                                <td>

                                    <input type="number"
                                           class="form-control producto-cantidad"
                                           value="1"
                                           min="1"
                                           max="@producto.Stock"
                                           disabled />

                                </td>

                            </tr>
                        }

                        <tr id="sinResultados"
                            style="display: none;">

                            <td colspan="6">

                                <div class="empty">
                                    No se encontraron productos con ese criterio.
                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>
    }

    <div class="form-card resumen-venta">

        <h2>Resumen</h2>

        <div id="detalleSeleccionado">

            <p class="secondary-text"
               id="mensajeVacio">
                No hay productos seleccionados.
            </p>

        </div>

        <div class="resumen-linea">
            <span>Subtotal</span>
            <strong id="subtotalTexto">₡0.00</strong>
        </div>

        <div class="resumen-linea">
            <span>IVA (13%)</span>
            <strong id="impuestoTexto">₡0.00</strong>
        </div>

        <div class="resumen-linea resumen-total">
            <span>Total</span>
            <strong id="totalTexto">₡0.00</strong>
        </div>

        <input asp-for="PorcentajeImpuesto"
               type="hidden" />

        <div id="camposProductos">
        </div>

        <div class="form-actions">

            <a asp-controller="Ventas"
               asp-action="Historial"
               class="btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn-primary"
                    id="btnRegistrar"
                    disabled>
                Registrar venta
            </button>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/ventas.js" asp-append-version="true"></script>
}
