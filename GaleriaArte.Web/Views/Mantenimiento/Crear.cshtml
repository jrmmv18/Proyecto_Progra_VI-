@model GaleriaArte.Web.Models.Mantenimiento

@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Nueva Orden Técnica";

    IEnumerable<SelectListItem> productosDisponibles =
        ViewBag.ProductosDisponibles as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    IEnumerable<SelectListItem> obrasDisponibles =
        ViewBag.ObrasDisponibles as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    if (Model.ProductosUsados == null ||
        Model.ProductosUsados.Count == 0)
    {
        Model.ProductosUsados =
            new List<ProductoUsadoMantenimiento>
            {
                new ProductoUsadoMantenimiento()
            };
    }
}

<div class="page-header">

    <h1>Nueva Orden de Mantenimiento</h1>

    <p>
        Ficha de registro técnico y preservación patrimonial.
    </p>

</div>

<form asp-controller="Mantenimiento"
      asp-action="Crear"
      method="post"
      id="mantenimientoForm">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>

    <!-- =====================================================
         DATOS DEL MANTENIMIENTO
    ====================================================== -->

    <div class="form-card">

        <div class="page-header">
            <h2>Datos del informe</h2>

            <p>
                Complete la información general del mantenimiento realizado.
            </p>
        </div>

        <div class="form-grid">

            <div class="form-group">

                <label asp-for="IdObra"
                       class="form-label">
                    Obra de arte
                </label>

                <select asp-for="IdObra"
                        asp-items="obrasDisponibles"
                        class="form-select"
                        required>

                    <option value="">
                        Seleccione una obra
                    </option>

                </select>

                <span asp-validation-for="IdObra"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="TipoMantenimiento"
                       class="form-label">
                    Tipo de mantenimiento
                </label>

                <select asp-for="TipoMantenimiento"
                        class="form-select"
                        required>

                    <option value="">
                        Seleccione un tipo
                    </option>

                    <option value="Preventivo">
                        Preventivo
                    </option>

                    <option value="Correctivo">
                        Correctivo
                    </option>

                    <option value="Restauración">
                        Restauración
                    </option>

                </select>

                <span asp-validation-for="TipoMantenimiento"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label for="FechaInput"
                       class="form-label">
                    Fecha del proceso
                </label>

                <input id="FechaInput"
                       type="date"
                       class="form-control"
                       required />

            </div>

            <div class="form-group">

                <label for="HoraInput"
                       class="form-label">
                    Hora del proceso
                </label>

                <input id="HoraInput"
                       type="time"
                       class="form-control"
                       required />

            </div>

            <input asp-for="FechaMantenimiento"
                   type="hidden"
                   id="FechaMantenimientoHidden" />

            <div class="form-group full">

                <span asp-validation-for="FechaMantenimiento"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group full">

                <label asp-for="DescripcionTrabajo"
                       class="form-label">
                    Diagnóstico técnico y acciones realizadas
                </label>

                <textarea asp-for="DescripcionTrabajo"
                          class="form-control form-textarea"
                          rows="5"
                          placeholder="Describa las intervenciones realizadas...">
                </textarea>

                <span asp-validation-for="DescripcionTrabajo"
                      class="field-validation">
                </span>

            </div>

        </div>

    </div>

    <!-- =====================================================
         PRODUCTOS UTILIZADOS
    ====================================================== -->

    <div class="form-card"
         style="margin-top: 24px;">

        <div class="page-header page-header-actions">

            <div>
                <h2>Productos e insumos utilizados</h2>

                <p>
                    Registre los materiales utilizados durante el mantenimiento.
                </p>
            </div>

            <button type="button"
                    id="btnAgregarProducto"
                    class="btn-secondary"
                    disabled="@(!productosDisponibles.Any())">
                + Agregar producto
            </button>

        </div>

        @if (!productosDisponibles.Any())
        {
            <div class="message">
                No hay productos activos con existencias disponibles.
            </div>
        }

        <div id="contenedorProductos">

            @for (int i = 0;
                  i < Model.ProductosUsados.Count;
                  i++)
            {
                <div class="producto-fila"
                     data-index="@i">

                    <div class="form-grid">

                        <div class="form-group">

                            <label class="form-label">
                                Producto
                            </label>

                            <select asp-for="ProductosUsados[i].IdProducto"
                                    asp-items="productosDisponibles"
                                    class="form-select producto-select"
                                    required>

                                <option value="">
                                    Seleccione un producto
                                </option>

                            </select>

                            <span asp-validation-for="ProductosUsados[i].IdProducto"
                                  class="field-validation">
                            </span>

                        </div>

                        <div class="form-group">

                            <label class="form-label">
                                Cantidad utilizada
                            </label>

                            <input asp-for="ProductosUsados[i].CantidadUtilizada"
                                   type="number"
                                   min="1"
                                   step="1"
                                   class="form-control cantidad-input"
                                   required />

                            <span asp-validation-for="ProductosUsados[i].CantidadUtilizada"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>

                    <div class="form-actions">

                        <button type="button"
                                class="btn-state btn-eliminar-producto">
                            Eliminar
                        </button>

                    </div>

                </div>
            }

        </div>

        <p class="secondary-text">
            Al confirmar el registro, las cantidades utilizadas serán
            descontadas automáticamente del inventario.
        </p>

    </div>

    <!-- =====================================================
         ACCIONES DEL FORMULARIO
    ====================================================== -->

    <div class="form-actions">

        <a asp-controller="Mantenimiento"
           asp-action="Index"
           class="btn-secondary">
            Regresar
        </a>

        <button type="submit"
                class="btn-primary"
                disabled="@(!productosDisponibles.Any())">
            Confirmar registro
        </button>

    </div>

</form>

<!-- =====================================================
     PLANTILLA PARA NUEVAS FILAS DE PRODUCTOS
====================================================== -->

<template id="plantillaProducto">

    <div class="producto-fila"
         data-index="__INDEX__">

        <div class="form-grid">

            <div class="form-group">

                <label class="form-label">
                    Producto
                </label>

                <select name="ProductosUsados[__INDEX__].IdProducto"
                        id="ProductosUsados___INDEX___IdProducto"
                        class="form-select producto-select"
                        required>

                    <option value="">
                        Seleccione un producto
                    </option>

                    @foreach (SelectListItem producto in productosDisponibles)
                    {
                        <option value="@producto.Value">
                            @producto.Text
                        </option>
                    }

                </select>

                <span class="field-validation"
                      data-valmsg-for="ProductosUsados[__INDEX__].IdProducto"
                      data-valmsg-replace="true">
                </span>

            </div>

            <div class="form-group">

                <label class="form-label">
                    Cantidad utilizada
                </label>

                <input name="ProductosUsados[__INDEX__].CantidadUtilizada"
                       id="ProductosUsados___INDEX___CantidadUtilizada"
                       type="number"
                       min="1"
                       step="1"
                       class="form-control cantidad-input"
                       required />

                <span class="field-validation"
                      data-valmsg-for="ProductosUsados[__INDEX__].CantidadUtilizada"
                      data-valmsg-replace="true">
                </span>

            </div>

        </div>

        <div class="form-actions">

            <button type="button"
                    class="btn-state btn-eliminar-producto">
                Eliminar
            </button>

        </div>

    </div>

</template>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const formulario =
                document.getElementById("mantenimientoForm");

            const fechaInput =
                document.getElementById("FechaInput");

            const horaInput =
                document.getElementById("HoraInput");

            const fechaOculta =
                document.getElementById("FechaMantenimientoHidden");

            const contenedorProductos =
                document.getElementById("contenedorProductos");

            const botonAgregarProducto =
                document.getElementById("btnAgregarProducto");

            const plantillaProducto =
                document.getElementById("plantillaProducto");

            cargarFechaYHora();
            configurarAgregarProducto();
            configurarEliminarProducto();
            configurarProductosDuplicados();
            configurarEnvioFormulario();
            actualizarBotonesEliminar();

            function cargarFechaYHora() {

                if (!fechaInput ||
                    !horaInput ||
                    !fechaOculta) {
                    return;
                }

                if (fechaOculta.value) {

                    const fechaNormalizada =
                        fechaOculta.value.replace(" ", "T");

                    const partes =
                        fechaNormalizada.split("T");

                    if (partes.length >= 1) {
                        fechaInput.value = partes[0];
                    }

                    if (partes.length >= 2) {
                        horaInput.value =
                            partes[1].substring(0, 5);
                    }
                }

                if (!fechaInput.value) {

                    const ahora = new Date();

                    const anio =
                        ahora.getFullYear();

                    const mes =
                        String(ahora.getMonth() + 1)
                            .padStart(2, "0");

                    const dia =
                        String(ahora.getDate())
                            .padStart(2, "0");

                    const hora =
                        String(ahora.getHours())
                            .padStart(2, "0");

                    const minutos =
                        String(ahora.getMinutes())
                            .padStart(2, "0");

                    fechaInput.value =
                        `${anio}-${mes}-${dia}`;

                    horaInput.value =
                        `${hora}:${minutos}`;
                }
            }

            function configurarAgregarProducto() {

                if (!botonAgregarProducto ||
                    !plantillaProducto ||
                    !contenedorProductos) {
                    return;
                }

                botonAgregarProducto.addEventListener(
                    "click",
                    function() {

                        const indice =
                            obtenerSiguienteIndice();

                        const html =
                            plantillaProducto.innerHTML.replaceAll(
                                "__INDEX__",
                                indice
                            );

                        contenedorProductos.insertAdjacentHTML(
                            "beforeend",
                            html
                        );

                        reindexarFilas();
                        actualizarBotonesEliminar();

                        const filas =
                            contenedorProductos.querySelectorAll(
                                ".producto-fila"
                            );

                        const ultimaFila =
                            filas[filas.length - 1];

                        const select =
                            ultimaFila?.querySelector(
                                ".producto-select"
                            );

                        if (select) {
                            select.focus();
                        }
                    }
                );
            }

            function configurarEliminarProducto() {

                if (!contenedorProductos) {
                    return;
                }

                contenedorProductos.addEventListener(
                    "click",
                    function(event) {

                        const boton =
                            event.target.closest(
                                ".btn-eliminar-producto"
                            );

                        if (!boton) {
                            return;
                        }

                        const filas =
                            contenedorProductos.querySelectorAll(
                                ".producto-fila"
                            );

                        const fila =
                            boton.closest(
                                ".producto-fila"
                            );

                        if (filas.length <= 1) {
                            limpiarFila(fila);
                            return;
                        }

                        fila?.remove();

                        reindexarFilas();
                        actualizarBotonesEliminar();
                    }
                );
            }

            function configurarProductosDuplicados() {

                if (!contenedorProductos) {
                    return;
                }

                contenedorProductos.addEventListener(
                    "change",
                    function(event) {

                        if (!event.target.classList.contains(
                            "producto-select"
                        )) {
                            return;
                        }

                        const valorSeleccionado =
                            event.target.value;

                        if (!valorSeleccionado) {
                            return;
                        }

                        const productosRepetidos =
                            Array.from(
                                contenedorProductos.querySelectorAll(
                                    ".producto-select"
                                )
                            ).filter(function(select) {
                                return select.value ===
                                    valorSeleccionado;
                            });

                        if (productosRepetidos.length > 1) {

                            alert(
                                "Este producto ya fue seleccionado."
                            );

                            event.target.value = "";
                            event.target.focus();
                        }
                    }
                );
            }

            function configurarEnvioFormulario() {

                if (!formulario) {
                    return;
                }

                formulario.addEventListener(
                    "submit",
                    function(event) {

                        actualizarFechaOculta();

                        if (!contenedorProductos) {
                            return;
                        }

                        const filas =
                            contenedorProductos.querySelectorAll(
                                ".producto-fila"
                            );

                        if (filas.length === 0) {

                            event.preventDefault();

                            alert(
                                "Debe agregar al menos un producto."
                            );

                            return;
                        }

                        const productosValidos =
                            Array.from(filas).filter(function(fila) {

                                const producto =
                                    fila.querySelector(
                                        ".producto-select"
                                    );

                                const cantidad =
                                    fila.querySelector(
                                        ".cantidad-input"
                                    );

                                return producto?.value &&
                                    Number(cantidad?.value) > 0;
                            });

                        if (productosValidos.length === 0) {

                            event.preventDefault();

                            alert(
                                "Debe seleccionar al menos un producto e indicar una cantidad válida."
                            );

                            return;
                        }

                        reindexarFilas();
                    }
                );
            }

            function actualizarFechaOculta() {

                if (!fechaInput ||
                    !horaInput ||
                    !fechaOculta) {
                    return;
                }

                const fecha =
                    fechaInput.value;

                const hora =
                    horaInput.value;

                if (fecha && hora) {

                    fechaOculta.value =
                        fecha + "T" + hora + ":00";

                    return;
                }

                if (fecha) {
                    fechaOculta.value =
                        fecha + "T00:00:00";
                }
            }

            function obtenerSiguienteIndice() {

                if (!contenedorProductos) {
                    return 0;
                }

                const filas =
                    contenedorProductos.querySelectorAll(
                        ".producto-fila"
                    );

                let indiceMayor = -1;

                filas.forEach(function(fila) {

                    const indice =
                        parseInt(
                            fila.dataset.index ?? "-1"
                        );

                    if (indice > indiceMayor) {
                        indiceMayor = indice;
                    }
                });

                return indiceMayor + 1;
            }

            function limpiarFila(fila) {

                if (!fila) {
                    return;
                }

                const select =
                    fila.querySelector(
                        ".producto-select"
                    );

                const cantidad =
                    fila.querySelector(
                        ".cantidad-input"
                    );

                if (select) {
                    select.value = "";
                }

                if (cantidad) {
                    cantidad.value = "";
                }

                select?.focus();
            }

            function reindexarFilas() {

                if (!contenedorProductos) {
                    return;
                }

                const filas =
                    contenedorProductos.querySelectorAll(
                        ".producto-fila"
                    );

                filas.forEach(function(fila, indice) {

                    fila.dataset.index =
                        indice.toString();

                    const controles =
                        fila.querySelectorAll(
                            "select, input, span[data-valmsg-for]"
                        );

                    controles.forEach(function(control) {

                        if (control.name) {

                            control.name =
                                control.name.replace(
                                    /ProductosUsados\[\d+\]/g,
                                    `ProductosUsados[${indice}]`
                                );
                        }

                        if (control.id) {

                            control.id =
                                control.id.replace(
                                    /ProductosUsados_\d+__/g,
                                    `ProductosUsados_${indice}__`
                                );
                        }

                        const nombreValidacion =
                            control.getAttribute(
                                "data-valmsg-for"
                            );

                        if (nombreValidacion) {

                            control.setAttribute(
                                "data-valmsg-for",
                                nombreValidacion.replace(
                                    /ProductosUsados\[\d+\]/g,
                                    `ProductosUsados[${indice}]`
                                )
                            );
                        }
                    });
                });
            }

            function actualizarBotonesEliminar() {

                if (!contenedorProductos) {
                    return;
                }

                const filas =
                    contenedorProductos.querySelectorAll(
                        ".producto-fila"
                    );

                filas.forEach(function(fila) {

                    const boton =
                        fila.querySelector(
                            ".btn-eliminar-producto"
                        );

                    if (boton) {

                        boton.textContent =
                            filas.length === 1
                                ? "Limpiar"
                                : "Eliminar";
                    }
                });
            }
        });
    </script>
}

