@model GaleriaArte.Web.Models.PaginacionInfo

@if (Model.TotalPaginas > 1)
{
    @*
        Ventana de hasta cinco numeros de pagina centrada
        en la pagina que se esta viendo.
    *@
    int desde = Math.Max(1, Model.PaginaActual - 2);
    int hasta = Math.Min(Model.TotalPaginas, desde + 4);
    desde = Math.Max(1, hasta - 4);

    <div class="pagination-bar">

        <div class="pagination">

            @if (Model.TienePaginaAnterior)
            {
                <a asp-controller="@Model.Controlador"
                   asp-action="@Model.Accion"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-fechaInicio="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                   asp-route-fechaFin="@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                   asp-route-pagina="@(Model.PaginaActual - 1)"
                   class="page-link"
                   title="Página anterior">
                    &#8249;
                </a>
            }
            else
            {
                <span class="page-link disabled">
                    &#8249;
                </span>
            }

            @for (int numero = desde; numero <= hasta; numero++)
            {
                if (numero == Model.PaginaActual)
                {
                    <span class="page-link active">
                        @numero
                    </span>
                }
                else
                {
                    <a asp-controller="@Model.Controlador"
                       asp-action="@Model.Accion"
                       asp-route-busqueda="@Model.Busqueda"
                       asp-route-fechaInicio="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                       asp-route-fechaFin="@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                       asp-route-pagina="@numero"
                       class="page-link">
                        @numero
                    </a>
                }
            }

            @if (Model.TienePaginaSiguiente)
            {
                <a asp-controller="@Model.Controlador"
                   asp-action="@Model.Accion"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-fechaInicio="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                   asp-route-fechaFin="@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                   asp-route-pagina="@(Model.PaginaActual + 1)"
                   class="page-link"
                   title="Página siguiente">
                    &#8250;
                </a>
            }
            else
            {
                <span class="page-link disabled">
                    &#8250;
                </span>
            }

        </div>

    </div>
}
