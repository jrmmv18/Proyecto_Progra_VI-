@model GaleriaArte.Web.Models.PaginacionInfo

<div class="filter-bar">

    <form asp-controller="@Model.Controlador"
          asp-action="@Model.Accion"
          method="get"
          class="filter-form">

        <input type="text"
               name="busqueda"
               value="@Model.Busqueda"
               class="form-control filter-input"
               placeholder="@Model.PlaceholderBusqueda"
               aria-label="Buscar" />

        @if (Model.MostrarFiltroFechas)
        {
            <span class="filter-label">@Model.EtiquetaFechas</span>

            <input type="date"
                   name="fechaInicio"
                   value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))"
                   class="form-control filter-date"
                   aria-label="@Model.EtiquetaFechas desde"
                   title="Desde" />

            <span class="filter-label">a</span>

            <input type="date"
                   name="fechaFin"
                   value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))"
                   class="form-control filter-date"
                   aria-label="@Model.EtiquetaFechas hasta"
                   title="Hasta" />
        }

        <button type="submit"
                class="btn-filter">
            Filtrar
        </button>

        @if (Model.HayFiltros)
        {
            <a asp-controller="@Model.Controlador"
               asp-action="@Model.Accion"
               class="btn-filter-clear">
                Limpiar
            </a>
        }

    </form>

</div>
