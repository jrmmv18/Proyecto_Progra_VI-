<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Galería de Arte</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</head>
   

<body>

@* Aplica el tema guardado antes de pintar la pagina, para que no parpadee *@
<script>
    if (localStorage.getItem("galeriaArte.tema") === "oscuro") {
        document.body.classList.add("tema-oscuro");
    }
</script>

@{
    var controlador = ViewContext.RouteData.Values["Controller"]?.ToString();

    var nombre = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "";

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

<div class="app">

   <aside class="sidebar">

    <!-- Logo -->

    <div class="brand">

        <img src="~/images/logo2.png"
             class="brand-logo"
             alt="Galería de Arte" />

        <div class="brand-title">
            GALERÍA DE ARTE
        </div>

        <div class="brand-subtitle">
            Sistema de Gestión
        </div>

    </div>

    <!-- Usuario -->

    <div class="user-info">

        <div class="user-avatar">
            <i class="bi bi-person-circle"></i>
        </div>

        <div>

            <div class="user-name">
                @nombre
            </div>

            <div class="user-role">
                @rol
            </div>

        </div>

    </div>

    <!-- Aquí empieza el menú -->



        <div class="menu-title">
    GENERAL
</div>

<a asp-controller="Home"
   asp-action="Index"
   class="menu-link @(controlador == "Home" ? "active" : "")">
    <i class="bi bi-speedometer2"></i>
    <span>Panel principal</span>
</a>

<div class="menu-divider"></div>

<div class="menu-title">
    GALERÍA
</div>

<a asp-controller="Obras"
   asp-action="Index"
   class="menu-link @(controlador == "Obras" ? "active" : "")">
    <i class="bi bi-image"></i>
    <span>Obras</span>
</a>

<a asp-controller="Artistas"
   asp-action="Index"
   class="menu-link @(controlador == "Artistas" ? "active" : "")">
    <i class="bi bi-palette"></i>
    <span>Artistas</span>
</a>

<a asp-controller="Visitas"
   asp-action="Index"
   class="menu-link @(controlador == "Visitas" ? "active" : "")">
    <i class="bi bi-people"></i>
    <span>Visitas</span>
</a>

<div class="menu-divider"></div>

<div class="menu-title">
    INVENTARIO
</div>

<a asp-controller="Productos"
   asp-action="Index"
   class="menu-link @(controlador == "Productos" ? "active" : "")">
    <i class="bi bi-box-seam"></i>
    <span>Productos</span>
</a>

<a asp-controller="Proveedores"
   asp-action="Index"
   class="menu-link @(controlador == "Proveedores" ? "active" : "")">
    <i class="bi bi-truck"></i>
    <span>Proveedores</span>
</a>

<a asp-controller="Mantenimiento"
   asp-action="Index"
   class="menu-link @(controlador == "Mantenimiento" ? "active" : "")">
    <i class="bi bi-tools"></i>
    <span>Mantenimiento</span>
</a>

<div class="menu-divider"></div>

<div class="menu-title">
    COMERCIAL
</div>

<a asp-controller="Ventas"
   asp-action="Index"
   class="menu-link @(controlador == "Ventas" ? "active" : "")">
    <i class="bi bi-cart-check"></i>
    <span>Ventas</span>
</a>

<div class="menu-divider"></div>

<div class="menu-title">
    ADMINISTRACIÓN
</div>

<a asp-controller="Usuarios"
   asp-action="Index"
   class="menu-link @(controlador == "Usuarios" ? "active" : "")">
    <i class="bi bi-person-gear"></i>
    <span>Usuarios</span>
</a>

<a asp-controller="AcercaDe"
   asp-action="Index"
   class="menu-link @(controlador == "AcercaDe" ? "active" : "")">
    <i class="bi bi-info-circle"></i>
    <span>Acerca de</span>
</a>


        <div class="tema-switch">

            <span class="tema-texto">Modo oscuro</span>

            <button type="button"
                    id="btnTema"
                    class="tema-toggle"
                    role="switch"
                    aria-checked="false"
                    aria-label="Cambiar entre modo claro y oscuro">
                <span class="tema-bolita"></span>
            </button>

        </div>

        <div class="logout">

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

               <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Cerrar sesión</span>
                </button>

            </form>

        </div>

    </aside>

    <main class="main">
        
        <!-- BOTÓN DE CONTROL GLOBAL: Integrado orgánicamente con la clase btn-secondary de tu CSS -->
        <!-- Se ubica al puro inicio del contenedor principal para que cubra todo el sitio web -->
        <div class="global-toggle-container">
            <button type="button" id="btnToggleMenu" class="btn-toggle-menu" aria-expanded="true">
                <i class="bi bi-list"></i>
                <span>Menú</span>
            </button>

        </div>

        @RenderBody()

    </main>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

<!-- NUEVO: Forzamos la inclusión global de tu script recuperado de la barra lateral -->
<script src="~/js/sidebar-toggle.js" asp-append-version="true"></script>

<script src="~/js/tema.js" asp-append-version="true"></script>

@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>
