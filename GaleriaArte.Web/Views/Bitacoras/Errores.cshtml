@model GaleriaArte.Web.Models.Paginacion<GaleriaArte.Web.Models.BitacoraError>

@{
    ViewData["Title"] = "Centro de Auditoría";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <a asp-controller="Bitacoras"
               asp-action="Index"
               class="btn btn-outline-secondary mb-3">

                <i class="bi bi-arrow-left"></i>

                Centro de Auditoría

            </a>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-journal-text"></i>

                Bitácora @ViewBag.Modulo

            </h2>

            <span class="text-muted">
                Registro de auditoría del módulo @ViewBag.Modulo
            </span>

        </div>

        <span class="badge bg-primary fs-6">

            Total: @Model.TotalRegistros registros

        </span>

    </div>

    <div class="card shadow border-0">

        <div class="table-responsive">

            <table class="table table-hover table-striped mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>Fecha</th>

                        <th>Usuario</th>

                        <th>Procedimiento</th>

                        <th>Error</th>
                        <th>Rollback</th>
                        <th>Detalle</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Datos.Any())
                    {
                        foreach (var item in Model.Datos)
                        {

                            <tr>

                                <td>
                                    @item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @item.NombreUsuario
                                </td>

                                <td>
                                    @item.Procedimiento
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        @item.NumeroError
                                    </span>
                                </td>

                                <td>

                                    @if (item.RollbackEjecutado)
                                    {
                                        <span class="badge bg-danger">
                                            SI
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            NO
                                        </span>
                                    }

                                </td>

                                <td>

                                    <button class="btn btn-sm btn-dark"
                                            data-bs-toggle="modal"
                                            data-bs-target="#detalleModal"
                                            onclick="mostrarDetalle('@item.Descripcion')">

                                        <i class="bi bi-eye"></i>

                                        Ver

                                    </button>

                                </td>


                            </tr>

                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="6" class="text-center py-5">

                                <i class="bi bi-folder-x display-4 text-secondary"></i>

                                <h5 class="mt-3">
                                    No existen registros
                                </h5>

                                <span class="text-muted">
                                    Esta bitácora aún no contiene información.
                                </span>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>



        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas
                </span>

                <div>

                    @if (Model.HayAnterior)
                    {
                        <a asp-action="@ViewBag.Modulo"
                           asp-route-pagina="@(Model.PaginaActual - 1)"
                           class="btn btn-outline-secondary btn-sm">

                            ← Anterior

                        </a>
                    }

                    @if (Model.HaySiguiente)
                    {
                        <a asp-action="@ViewBag.Modulo"
                           asp-route-pagina="@(Model.PaginaActual + 1)"
                           class="btn btn-dark btn-sm">

                            Siguiente →

                        </a>
                    }

                </div>

            </div>

        </div>





    </div>

</div>


<div class="modal fade"
     id="detalleModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header bg-dark text-white">

                <h5 class="modal-title">

                    Detalle del Registro

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <pre id="detalleTexto"
                     style="white-space:pre-wrap"></pre>

            </div>

        </div>

    </div>

</div>


<script>

    function mostrarDetalle(texto) {

        document.getElementById("detalleTexto").innerText = texto;

    }

</script>