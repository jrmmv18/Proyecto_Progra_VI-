@model GaleriaArte.Web.Models.Paginacion<GaleriaArte.Web.Models.BitacoraGeneral>

@{
    ViewData["Title"] = "Centro de Auditoría";
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-text"></i>
                Centro de Auditoría
            </h2>

            <span class="text-muted">
                Registro de auditoría del Sistema de Gestión de la Galería de Arte
            </span>

        </div>

        <span class="badge bg-primary fs-6 px-3 py-2">
            Total: @Model.TotalRegistros registros
        </span>

    </div>

    <div class="card shadow border-0">

        <!-- Menú -->
        <div class="card-header bg-white border-bottom">

            <div class="btn-group flex-wrap">

                <a asp-action="Index" class="btn btn-dark">
                    <i class="bi bi-list-ul"></i>
                    General
                </a>

                <a asp-action="Inventario" class="btn btn-outline-dark">
                    Inventario
                </a>

                <a asp-action="Obras" class="btn btn-outline-dark">
                    Obras
                </a>

                <a asp-action="Seguridad" class="btn btn-outline-dark">
                    Seguridad
                </a>

                <a asp-action="Ventas" class="btn btn-outline-dark">
                    Ventas
                </a>

                <a asp-action="Visitas" class="btn btn-outline-dark">
                    Visitas
                </a>

                <a asp-action="Mantenimiento" class="btn btn-outline-dark">
                    Mantenimiento
                </a>

                <a asp-action="Errores" class="btn btn-outline-danger">
                    Errores
                </a>

            </div>

        </div>

        <!-- Tabla -->
        <div class="table-responsive">

            <table class="table table-hover table-striped mb-0">

                <thead class="table-dark">

                    <tr>

                        <th>Fecha</th>

                        <th>Usuario</th>

                        <th>Módulo</th>

                        <th>Tabla</th>

                        <th>Operación</th>

                        <th>Registro</th>

                        <th>Resultado</th>

                        <th width="110" class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Datos.Any())
                    {
                        foreach (var item in Model.Datos)
                        {
                            <tr>

                                <td>
                                    @item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @item.NombreUsuario
                                </td>

                                <td>
                                    @item.Modulo
                                </td>

                                <td>
                                    @item.TablaAfectada
                                </td>

                                <td>

                                    @if (item.TipoOperacion == "INSERT")
                                    {
                                        <span class="badge bg-success">
                                            INSERT
                                        </span>
                                    }
                                    else if (item.TipoOperacion == "UPDATE")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            UPDATE
                                        </span>
                                    }
                                    else if (item.TipoOperacion == "DELETE")
                                    {
                                        <span class="badge bg-danger">
                                            DELETE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.TipoOperacion
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.RegistroAfectado
                                </td>

                                <td>

                                    @if (item.Resultado == "EXITOSO")
                                    {
                                        <span class="badge bg-success">
                                            EXITOSO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            @item.Resultado
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Detalle"
                                       asp-route-id="@item.IdBitacora"
                                       class="btn btn-sm btn-primary">

                                        <i class="bi bi-eye"></i>

                                        Ver

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8" class="text-center py-5">

                                <i class="bi bi-folder-x display-5 text-secondary"></i>

                                <h5 class="mt-3">
                                    No existen registros
                                </h5>

                                <span class="text-muted">
                                    La bitácora aún no contiene información.
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Paginación -->
        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas
                </span>

                <div>

                    @if (Model.HayAnterior)
                    {
                        <a asp-action="Index"
                           asp-route-pagina="@(Model.PaginaActual - 1)"
                           class="btn btn-outline-secondary btn-sm">

                            ← Anterior

                        </a>
                    }

                    @if (Model.HaySiguiente)
                    {
                        <a asp-action="Index"
                           asp-route-pagina="@(Model.PaginaActual + 1)"
                           class="btn btn-dark btn-sm">

                            Siguiente →

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>