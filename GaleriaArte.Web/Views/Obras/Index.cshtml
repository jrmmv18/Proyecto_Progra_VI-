@model GaleriaArte.Web.Models.ListaPaginada<GaleriaArte.Web.Models.Obra>

@{
    ViewData["Title"] = "Obras";
}

<div class="page-header page-header-actions">

    <div>
        <h1>Obras</h1>
        <p>Administración de las obras registradas en la galería.</p>
    </div>

    <a asp-controller="Obras"
       asp-action="Create"
       class="btn-primary">
        + Nueva obra
    </a>

</div>

@if (TempData["Mensaje"] != null)
{
    <div class="message">
        @TempData["Mensaje"]
    </div>
}

<partial name="_Filtros" model="Model.Paginacion" />

@if (Model.Items.Count == 0)
{
    <div class="table-card">

        <div class="empty">
            @(Model.Paginacion.HayFiltros
                ? "No se encontraron resultados con los filtros aplicados."
                : "No hay obras registradas.")
        </div>

    </div>
}
else
{
    <div class="table-card">

        <div class="table-responsive">

            <table class="data-table obras-table">

                <thead>
                    <tr>
                        <th>Obra</th>
                        <th>Artista</th>
                        <th>Categoría</th>
                        <th>Fecha de creación</th>
                        <th>Valor estimado</th>
                        <th>Conservación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var obra in Model.Items)
                    {
                        <tr>

                            <td>
                                <div class="obra-name">
                                    @obra.Nombre
                                </div>

                                <div class="obra-code">
                                    @obra.Codigo
                                </div>
                            </td>

                            <td>
                                <div class="artist-name">
                                    @obra.NombreArtista
                                </div>
                            </td>

                            <td>
                                <div class="category-name">
                                    @obra.NombreCategoria
                                </div>
                            </td>

                            <td>
                                @(obra.FechaCreacion?.ToString("dd/MM/yyyy")
                                    ?? "No registrada")
                            </td>

                            <td>
                                <div class="value @obra.ClaseValor">
                                    ₡@obra.ValorEstimado.ToString("N2")
                                </div>
                            </td>

                            <td>
                                <span class="badge conservation">
                                    @obra.EstadoConservacion
                                </span>
                            </td>

                            <td>
                                @if (obra.Estado)
                                {
                                    <span class="badge status-active">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge status-inactive">
                                        Inactiva
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="table-actions">

                                    <a asp-controller="Obras"
                                       asp-action="Edit"
                                       asp-route-id="@obra.IdObra"
                                       class="btn-edit">
                                        Editar
                                    </a>

                                    <form asp-controller="Obras"
                                          asp-action="CambiarEstado"
                                          asp-route-id="@obra.IdObra"
                                          method="post"
                                          data-nombre="@obra.Nombre"
                                          data-activa="@obra.Estado.ToString().ToLowerInvariant()"
                                          onsubmit="return confirmarCambioEstado(this);">

                                        @Html.AntiForgeryToken()

                                        @if (obra.Estado)
                                        {
                                            <button type="submit"
                                                    class="btn-state">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn-state">
                                                Activar
                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

<partial name="_Paginacion" model="Model.Paginacion" />

@section Scripts
{
    <script>
        function confirmarCambioEstado(formulario) {

            const nombreObra =
                formulario.dataset.nombre || "seleccionada";

            const estaActiva =
                formulario.dataset.activa === "true";

            if (estaActiva) {
                return confirm(
                    "¿Está seguro de que desea desactivar la obra " +
                    nombreObra +
                    "?"
                );
            }

            return confirm(
                "¿Está seguro de que desea activar la obra " +
                nombreObra +
                "?"
            );
        }
    </script>
}