@model GaleriaArte.Web.Models.Obra

@{
    ViewData["Title"] = "Editar obra";
}

<div class="page-header">

    <h1>Editar obra</h1>

    <p>
        Actualiza la información de la obra seleccionada.
    </p>

</div>

<!-- ========================================== -->
<!-- FORMULARIO 1: EDICIÓN DE DATOS DE LA OBRA -->
<!-- ========================================== -->
<div class="form-card">

    <form asp-controller="Obras"
          asp-action="Edit"
          asp-route-id="@Model.IdObra"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="IdObra"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="form-grid">

            <div class="form-group">

                <label asp-for="IdArtista">
                    Artista
                </label>

                <select asp-for="IdArtista"
                        asp-items="ViewBag.Artistas"
                        class="form-control">

                    <option value="">
                        Seleccione un artista
                    </option>

                </select>

                <span asp-validation-for="IdArtista"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="IdCategoria">
                    Categoría
                </label>

                <select asp-for="IdCategoria"
                        asp-items="ViewBag.Categorias"
                        class="form-control">

                    <option value="">
                        Seleccione una categoría
                    </option>

                </select>

                <span asp-validation-for="IdCategoria"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Codigo"></label>

                <input asp-for="Codigo"
                       class="form-control"
                       placeholder="Ejemplo: OBR-002"
                       readonly />

                <span asp-validation-for="Codigo"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Nombre"></label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Ingrese el nombre de la obra" />

                <span asp-validation-for="Nombre"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="FechaCreacion"></label>

                <input asp-for="FechaCreacion"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="FechaCreacion"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ValorEstimado"></label>

                <input asp-for="ValorEstimado"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="ValorEstimado"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group full">

                <label asp-for="EstadoConservacion"></label>

                <select asp-for="EstadoConservacion"
                        class="form-control">

                    <option value="">
                        Seleccione el estado de conservación
                    </option>

                    <option value="Excelente">Excelente</option>
                    <option value="Bueno">Bueno</option>
                    <option value="Regular">Regular</option>
                    <option value="Restauración">Restauración</option>

                </select>

                <span asp-validation-for="EstadoConservacion"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group full">

                <label asp-for="Descripcion"></label>

                <textarea asp-for="Descripcion"
                          class="form-control form-textarea">
                </textarea>

                <span asp-validation-for="Descripcion"
                      class="field-validation">
                </span>

            </div>

        </div>

        <div class="form-actions">

            <a asp-controller="Obras"
               asp-action="Index"
               class="btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn-primary">
                Guardar cambios
            </button>

        </div>

    </form>

</div>

<!-- ========================================== -->
<!-- FORMULARIO 2: CONSUMO DE PRODUCTOS        -->
<!-- ========================================== -->
<div class="form-card" style="margin-top: 2rem;">

    <div class="page-header" style="margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee;">
        <h2>Productos e Insumos Utilizados</h2>
        <p>Seleccione los productos consumidos para esta obra para reducirlos del inventario.</p>
    </div>

    <form asp-controller="Obras"
          asp-action="RegistrarConsumoProducto"
          method="post">

        @Html.AntiForgeryToken()

        <!-- Pasa el ID de la obra actual de manera oculta -->
        <input type="hidden" name="IdObra" value="@Model.IdObra" />

        <div class="form-grid">

            <div class="form-group">
                <label for="IdProducto">Producto / Material</label>
                <select id="IdProducto" name="IdProducto" class="form-control" required>
                    <option value="">Seleccione un producto</option>
                    @if (ViewBag.Productos != null)
                    {
                        foreach (var producto in ViewBag.Productos)
                        {
                            <option value="@producto.IdProducto">
                                @producto.Nombre (Stock: @producto.Stock)
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="CantidadUsada">Cantidad a utilizar</label>
                <input type="number" id="CantidadUsada" name="CantidadUsada"
                       class="form-control" min="1" placeholder="Ejemplo: 3" required />
            </div>

        </div>

        <div class="form-actions" style="margin-top: 1.5rem;">
            <button type="submit" class="btn-primary" style="background-color: #28a745; border-color: #28a745;">
                Rebajar del Inventario
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}
