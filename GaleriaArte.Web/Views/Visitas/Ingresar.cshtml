@model GaleriaArte.Web.Models.Visita

@{
    ViewData["Title"] = "Ingresar visitante";
}

<div class="page-header page-header-actions">

    <div>
        <h1>Ingresar visitante</h1>
        <p>Marque la entrada de un cliente que ya está registrado.</p>
    </div>

    <a asp-controller="Clientes"
       asp-action="Index"
       class="btn-secondary">
        Volver
    </a>

</div>

<div class="table-card">

    <div class="p-4">

        <form asp-controller="Visitas"
              asp-action="Ingresar"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="IdCliente"
                           class="form-label">
                    </label>

                    <select asp-for="IdCliente"
                            asp-items="ViewBag.Clientes"
                            class="form-select">

                        <option value="">
                            Seleccione un visitante
                        </option>

                    </select>

                    <span asp-validation-for="IdCliente"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="FechaIngreso"
                           class="form-label">
                    </label>

                    <input asp-for="FechaIngreso"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="FechaIngreso"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="Observaciones"
                       class="form-label">
                </label>

                <textarea asp-for="Observaciones"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Observaciones"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn-primary">
                    Ingresar visitante
                </button>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
