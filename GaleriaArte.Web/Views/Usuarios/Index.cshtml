@model GaleriaArte.Web.Models.ListaPaginada<GaleriaArte.Web.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="page-header page-header-actions">

    <div>
        <h1>Usuarios</h1>
        <p>Administración de los usuarios del sistema.</p>
    </div>

    <a asp-controller="Usuarios"
       asp-action="Create"
       class="btn-primary">
        + Nuevo usuario
    </a>

</div>

@if (TempData["Mensaje"] != null)
{
    <div class="message">
        @TempData["Mensaje"]
    </div>
}

<partial name="_Filtros" model="Model.Paginacion" />

@if (Model.Items.Count == 0)
{
    <div class="table-card">

        <div class="empty">
            @(Model.Paginacion.HayFiltros
                ? "No se encontraron resultados con los filtros aplicados."
                : "No hay usuarios registrados.")
        </div>

    </div>
}
else
{
    <div class="table-card">

        <div class="table-responsive">

            <table class="data-table">

                <thead>

                    <tr>

                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Fecha registro</th>
                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var usuario in Model.Items)
                    {
                        <tr>

                            <td>

                                <div class="obra-name">
                                    @usuario.Nombre @usuario.Apellido
                                </div>

                            </td>

                            <td>

                                <div class="obra-code">
                                    @usuario.NombreUsuario
                                </div>

                            </td>

                            <td>
                                @usuario.Correo
                            </td>

                            <td>
                                @usuario.Rol
                            </td>

                            <td>

                                @if (usuario.Estado)
                                {
                                    <span class="badge status-active">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge status-inactive">
                                        Inactivo
                                    </span>
                                }

                            </td>

                            <td>
                                @usuario.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                <div class="table-actions">

                                    <a asp-controller="Usuarios"
                                       asp-action="Edit"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn-edit">
                                        Editar
                                    </a>

                                    <form asp-controller="Usuarios"
                                          asp-action="CambiarEstado"
                                          asp-route-id="@usuario.IdUsuario"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-state">

                                            @(usuario.Estado
                                                ? "Desactivar"
                                                : "Activar")

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}
<partial name="_Paginacion" model="Model.Paginacion" />
