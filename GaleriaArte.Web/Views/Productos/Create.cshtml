@model GaleriaArte.Web.Models.Producto

@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="page-header">

    <h1>Nuevo producto</h1>

    <p>
        Registre un nuevo producto para el inventario.
    </p>

</div>

<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="form-grid">

            <div class="form-group">

                <label asp-for="IdProveedor"></label>

                <select asp-for="IdProveedor"
                        asp-items="ViewBag.Proveedores"
                        class="form-control">

                    <option value="">
                        Seleccione un proveedor
                    </option>

                </select>

                <span asp-validation-for="IdProveedor"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Codigo"></label>

                <input asp-for="Codigo"
                       class="form-control"
                       placeholder="Ejemplo: PROD-001" />

                <span asp-validation-for="Codigo"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Nombre"></label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Nombre del producto" />

                <span asp-validation-for="Nombre"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Precio"></label>

                <input asp-for="Precio"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control"
                       placeholder="0.00" />

                <span asp-validation-for="Precio"
                      class="field-validation">
                </span>

            </div>
            <div class="form-group">

                <label asp-for="Stock"></label>

                <input asp-for="Stock"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="0" />

                <span asp-validation-for="Stock"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="StockMinimo"></label>

                <input asp-for="StockMinimo"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="0" />

                <span asp-validation-for="StockMinimo"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group full-width">

                <label asp-for="Descripcion"></label>

                <textarea asp-for="Descripcion"
                          rows="5"
                          class="form-control"
                          placeholder="Descripción del producto (opcional)">
                </textarea>

                <span asp-validation-for="Descripcion"
                      class="field-validation">
                </span>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn-primary">
                Guardar producto
            </button>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}