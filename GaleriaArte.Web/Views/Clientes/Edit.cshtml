@model GaleriaArte.Web.Models.Cliente

@{
    ViewData["Title"] = "Editar cliente";
}

<div class="page-header page-header-actions">

    <div>
        <h1>Editar cliente</h1>
        <p>Actualización de la información del cliente.</p>
    </div>

    <a asp-controller="Clientes"
       asp-action="Index"
       class="btn-secondary">
        Volver
    </a>

</div>

<div class="table-card">

    <div class="p-4">

        <form asp-controller="Clientes"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="IdCliente"
                   type="hidden" />

            <input asp-for="Estado"
                   type="hidden" />

            <input asp-for="FechaRegistro"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Nombre"
                           class="form-label">
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Apellido"
                           class="form-label">
                    </label>

                    <input asp-for="Apellido"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Apellido"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Telefono"
                           class="form-label">
                    </label>

                    <input asp-for="Telefono"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Telefono"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Correo"
                           class="form-label">
                    </label>

                    <input asp-for="Correo"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="Correo"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="Direccion"
                       class="form-label">
                </label>

                <textarea asp-for="Direccion"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Direccion"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn-primary">
                    Guardar cambios
                </button>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn-secondary">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}